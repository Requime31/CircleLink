# Required — Firebase project ID (matches GoogleService-Info.plist PROJECT_ID)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Option A: full service account JSON as a single-line string (Railway / Render)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Option B: path to service account file (local dev)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# WebSocket server port (platforms like Railway inject PORT automatically)
PORT=8080

# How long to wait for the auth event after connect (milliseconds)
AUTH_TIMEOUT_MS=10000
