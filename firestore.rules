rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function chatDoc(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId));
    }

    function chatExists(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId));
    }

    function isChatParticipant(chatId) {
      return isSignedIn()
        && chatExists(chatId)
        && request.auth.uid in chatDoc(chatId).data.get('participantIds', []);
    }

    // Allow reads when chat is new (not created yet) or user is a participant.
    function canAccessChat(chatId) {
      return isSignedIn()
        && (!chatExists(chatId) || request.auth.uid in chatDoc(chatId).data.get('participantIds', []));
    }

    function isCommunityMember(communityId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }

    // Group chats require community membership — blocks self-join via knowing group_{id}.
    function canWriteGroupChat() {
      return request.resource.data.get('type', '') != 'group'
        || (
          request.resource.data.keys().hasAll(['communityId'])
          && isCommunityMember(request.resource.data.communityId)
        );
    }

    function canUpdateExistingGroupChat(chatId) {
      return !chatExists(chatId)
        || chatDoc(chatId).data.get('type', 'direct') != 'group'
        || (
          chatDoc(chatId).data.keys().hasAll(['communityId'])
          && isCommunityMember(chatDoc(chatId).data.communityId)
        );
    }

    // Phase 2–3: user profiles (+ Phase 9 fcmToken on same doc, owner-only write)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;

      // Phase 8: per-user chat references
      // Owner always; a chat participant may write another participant's ref
      // (needed so createDirectChat / sendMessage can batch-update both sides).
      match /chatRefs/{chatId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && (
          request.auth.uid == userId
          || (
            chatExists(chatId)
            && request.auth.uid in chatDoc(chatId).data.get('participantIds', [])
            && userId in chatDoc(chatId).data.get('participantIds', [])
          )
        );
      }
    }

    // Phase 5: interest-based communities
    match /communities/{communityId} {
      allow read: if isSignedIn();

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']);

      match /members/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Phase 6 / 10: chat messages (+ group chat membership)
    match /chats/{chatId} {
      allow read: if canAccessChat(chatId);

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.get('participantIds', [])
        && canWriteGroupChat();

      // Participant can update metadata.
      // Self-join via arrayUnion is allowed only for direct chats, or group chats
      // when the user is a current community member.
      allow update: if isSignedIn()
        && canUpdateExistingGroupChat(chatId)
        && (
          isChatParticipant(chatId)
          || request.auth.uid in request.resource.data.get('participantIds', [])
        );

      match /messages/{messageId} {
        allow read: if canAccessChat(chatId);

        allow create: if isSignedIn()
          && request.auth.uid == request.resource.data.senderId
          && canAccessChat(chatId)
          && canUpdateExistingGroupChat(chatId);

        allow update, delete: if false;
      }
    }

    // Phase 8: connection / matching requests
    // Document ID == pairKey (sorted uids) so duplicates cannot be created.
    match /connectionRequests/{requestId} {
      // resource == null: allow get of missing docs (needed for create transactions).
      allow get: if isSignedIn() && (
        resource == null
        || request.auth.uid == resource.data.fromUserId
        || request.auth.uid == resource.data.toUserId
      );

      allow list: if isSignedIn() && (
        request.auth.uid == resource.data.fromUserId
        || request.auth.uid == resource.data.toUserId
      );

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.status == 'pending'
        && request.resource.data.fromUserId != request.resource.data.toUserId
        && request.resource.data.pairKey == requestId
        && request.resource.data.keys().hasAll([
          'fromUserId', 'toUserId', 'communityId', 'status', 'createdAt', 'pairKey'
        ]);

      allow update: if isSignedIn() && (
        // Recipient accepts or declines a pending request.
        (
          request.auth.uid == resource.data.toUserId
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
        // Either party may reopen a declined request as a new pending connect.
        || (
          resource.data.status == 'declined'
          && request.auth.uid == request.resource.data.fromUserId
          && request.resource.data.status == 'pending'
          && request.resource.data.fromUserId != request.resource.data.toUserId
          && request.resource.data.pairKey == requestId
        )
      );

      allow delete: if false;
    }
  }
}
